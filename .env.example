# Browser/API
VITE_API_BASE_URL=/api
# Optional same-origin or CORS-enabled collector; payloads contain no project/user data.
VITE_TELEMETRY_ENDPOINT=
# ASP.NET Core production settings (store real values in a secret manager)
ASPNETCORE_ENVIRONMENT=Production
DatabaseProvider=SqlServer
ConnectionStrings__Default=Server=sql;Database=AcThermal;User Id=sa;Password=CHANGE_IN_SECRET_MANAGER;TrustServerCertificate=true
ShareTokenPepper=CHANGE_IN_SECRET_MANAGER
AllowedOrigins__0=https://simulator.example.com
MSSQL_SA_PASSWORD=CHANGE_IN_SECRET_MANAGER
